# ===================================================================
# AI SMART FARMING ASSISTANT (AgriAI) - ENVIRONMENT TEMPLATE
# ===================================================================

# Database Configuration (PostgreSQL with pgvector for production / SQLite for local)
DB_ENGINE=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=agriai_db
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@127.0.0.1:5432/agriai_db

# AI Integration & Vector Database
VECTOR_DB_TYPE=pgvector
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agriai_docs

# Google Gemini API Key
GEMINI_API_KEY=

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment & Networking
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
LOG_LEVEL=INFO
